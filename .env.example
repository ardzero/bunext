# Copy to .env.local (`bun run setup` does this for you) and fill in the values.

# ── Better Auth ──────────────────────────────────────────────
# Signs and encrypts sessions. At least 32 characters; keep it stable,
# changing it signs everyone out. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical base URL. Required in production (e.g. https://example.com), except
# on Vercel: production falls back to the project's production domain and
# previews to the branch URL.
BETTER_AUTH_URL=http://localhost:3000

# ── Database (Postgres) ──────────────────────────────────────
# Runtime connection. Use the pooled URL where your provider offers one
# (Neon: the "-pooler" host).
DATABASE_URL=
# Optional direct (unpooled) connection, used by drizzle-kit for migrations.
# Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── First admin ──────────────────────────────────────────────
# `bun run seed:admin` promotes the existing user with this email to admin.
ADMIN_EMAIL=

# ── Social providers (optional) ──────────────────────────────
# A provider is enabled only when both its values are set.
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Mail (required in production) ────────────────────────────
# With both set, mail is sent through Resend and email verification becomes
# required. Without them, development prints mail to the server console and
# production refuses to start (see ALLOW_NO_MAILER).
RESEND_API_KEY=
# Verified sender, e.g. "Bunext <auth@example.com>"
MAIL_FROM=
# `true` lets production run without a mailer: no email is sent, sign-up skips
# verification, and password reset and magic links are turned off.
ALLOW_NO_MAILER=
