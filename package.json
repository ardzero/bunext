{
	"name": "bunext",
	"description": "Bunext - A Next.js 16 template with Tailwind CSS, shadcn ui and Bun with some utilities built in",
	"author": "Ard Astroid <ardastroid@gmail.com>",
	"version": "2.0.0",
	"private": true,
	"keywords": [
		"next.js",
		"react",
		"typescript",
		"tailwindcss",
		"shadcn-ui",
		"bun",
		"template",
		"starter"
	],
	"scripts": {
		"clean": "rm -rf .next",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"preview": "next build && next start",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
		"generate:icons": "bun scripts/generate-icons.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.61.0",
		"motion": "^14.6.0",
		"next": "16.4.3",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"schema-dts": "^2.1.0",
		"shadcn": "^4.22.1",
		"shiki": "^4.5.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "10.13.0",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-motion": "^1.1.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"bun": {
		"runtime": true
	}
}
