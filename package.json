{
	"name": "bunext",
	"description": "Bunext - A Next.js 16 template with Tailwind CSS, shadcn ui and Bun with some utilities built in",
	"author": "Ard Astroid <ardastroid@gmail.com>",
	"version": "2.0.0",
	"private": true,
	"keywords": [
		"next.js",
		"react",
		"typescript",
		"tailwindcss",
		"shadcn-ui",
		"bun",
		"template",
		"starter"
	],
	"scripts": {
		"clean": "rm -rf .next",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"preview": "next build && next start",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
		"test": "bun test --conditions=react-server --env-file=.env.local",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "bun --conditions=react-server node_modules/.bin/auth generate --config src/lib/auth/auth.ts --output src/lib/db/schema/auth.ts --yes",
		"setup": "bun scripts/setup.ts",
		"seed:admin": "bun --conditions=react-server scripts/seed-admin.ts",
		"generate:icons": "bun scripts/generate-icons.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"better-auth": "1.7.23",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "0.45.4",
		"lucide-react": "^1.72.0",
		"motion": "^14.13.0",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"nuqs": "^2.10.3",
		"postgres": "4.1.1",
		"radix-ui": "^1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"resend": "6.38.0",
		"schema-dts": "^2.1.0",
		"server-only": "0.0.1",
		"shadcn": "^4.23.0",
		"shiki": "^4.6.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.5",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"auth": "1.7.23",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "0.31.11",
		"eslint": "10.14.0",
		"eslint-config-next": "16.4.6",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.5",
		"tailwindcss-motion": "^1.1.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"bun": {
		"runtime": true
	}
}
